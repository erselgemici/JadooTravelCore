@model JadooTravel.Dtos.DestinationDtos.UpdateDestinationDto
@{
    ViewData["Title"] = "Tur Güncelle";
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">
                        <iconify-icon icon="mdi:airplane-edit" class="me-2"></iconify-icon> Tur Güncelle
                    </h5>
                    <a href="/Destination/Index" class="btn btn-light btn-sm">
                        <iconify-icon icon="mdi:arrow-left"></iconify-icon> Geri Dön
                    </a>
                </div>

                <div class="card-body p-4">
                    <form method="post">
                        <input type="hidden" asp-for="DestinationId" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CityCountry" class="form-label fw-semibold">
                                    <iconify-icon icon="mdi:map-marker-outline" class="me-1 text-success"></iconify-icon>
                                    Şehir / Ülke
                                </label>
                                <input asp-for="CityCountry" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ImageUrl" class="form-label fw-semibold">
                                    <iconify-icon icon="mdi:image-outline" class="me-1 text-success"></iconify-icon>
                                    Görsel URL
                                </label>
                                <input asp-for="ImageUrl" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-semibold">
                                    <iconify-icon icon="mdi:currency-try" class="me-1 text-success"></iconify-icon>
                                    Fiyat
                                </label>
                                <input asp-for="Price" class="form-control" type="number" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DayNight" class="form-label fw-semibold">
                                    <iconify-icon icon="mdi:weather-night" class="me-1 text-success"></iconify-icon>
                                    Gün / Gece
                                </label>
                                <input asp-for="DayNight" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Capacity" class="form-label fw-semibold">
                                    <iconify-icon icon="mdi:account-group-outline" class="me-1 text-success"></iconify-icon>
                                    Kapasite
                                </label>
                                <input asp-for="Capacity" class="form-control" type="number" />
                            </div>

                            <div class="col-12 mb-3">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    <iconify-icon icon="mdi:text-box-outline" class="me-1 text-success"></iconify-icon>
                                    Açıklama
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            </div>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-success">
                                <iconify-icon icon="mdi:content-save-edit-outline" class="me-1"></iconify-icon> Güncelle
                            </button>
                            <a href="/Destination/Index" class="btn btn-outline-secondary">
                                <iconify-icon icon="mdi:close-circle-outline"></iconify-icon> İptal
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
