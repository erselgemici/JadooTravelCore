@model JadooTravel.Dtos.DestinationDtos.CreateDestinationDto
@{
    ViewData["Title"] = "Yeni Tur Ekle";
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">
                        <iconify-icon icon="mdi:airplane-plus" class="me-2"></iconify-icon> Yeni Tur Ekle
                    </h5>
                    <a href="/Destination/Index" class="btn btn-light btn-sm">
                        <iconify-icon icon="mdi:arrow-left"></iconify-icon> Geri Dön
                    </a>
                </div>

                <div class="card-body p-4">
                    <form method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CityCountry" class="form-label fw-semibold">
                                    <iconify-icon icon="mdi:map-marker-outline" class="me-1 text-primary"></iconify-icon>
                                    Şehir / Ülke
                                </label>
                                <input asp-for="CityCountry" class="form-control" placeholder="Örn: Paris, Fransa" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ImageUrl" class="form-label fw-semibold">
                                    <iconify-icon icon="mdi:image-outline" class="me-1 text-primary"></iconify-icon>
                                    Görsel URL
                                </label>
                                <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-semibold">
                                    <iconify-icon icon="mdi:currency-try" class="me-1 text-primary"></iconify-icon>
                                    Fiyat
                                </label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DayNight" class="form-label fw-semibold">
                                    <iconify-icon icon="mdi:weather-night" class="me-1 text-primary"></iconify-icon>
                                    Gün / Gece
                                </label>
                                <input asp-for="DayNight" class="form-control" placeholder="5 Gün / 4 Gece" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Capacity" class="form-label fw-semibold">
                                    <iconify-icon icon="mdi:account-group-outline" class="me-1 text-primary"></iconify-icon>
                                    Kapasite
                                </label>
                                <input asp-for="Capacity" class="form-control" type="number" />
                            </div>

                            <div class="col-12 mb-3">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    <iconify-icon icon="mdi:text-box-outline" class="me-1 text-primary"></iconify-icon>
                                    Açıklama
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Tur hakkında kısa açıklama yazınız"></textarea>
                            </div>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">
                                <iconify-icon icon="mdi:content-save-outline" class="me-1"></iconify-icon> Kaydet
                            </button>
                            <button type="reset" class="btn btn-outline-secondary">
                                <iconify-icon icon="mdi:refresh"></iconify-icon> Temizle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
