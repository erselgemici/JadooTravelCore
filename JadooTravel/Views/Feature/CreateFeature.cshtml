@model Feature
@{
    ViewData["Title"] = "Yeni Özellik Ekle";
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="card mt-4 shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="ti ti-plus"></i> Yeni Özellik Ekle</h5>
        <a href="/Feature/Index" class="btn btn-light btn-sm">
            <i class="ti ti-arrow-left"></i> Geri Dön
        </a>
    </div>

    <div class="card-body">
        <form method="post">
            <div class="mb-3">
                <label class="form-label fw-semibold">Başlık</label>
                <input asp-for="Title" class="form-control" placeholder="Başlık giriniz" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Ana Başlık</label>
                <input asp-for="MainTitle" class="form-control" placeholder="Ana başlık giriniz" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Açıklama</label>
                <textarea asp-for="Description" rows="3" class="form-control" placeholder="Açıklama giriniz"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Video URL</label>
                <input asp-for="VideoUrl" class="form-control" placeholder="Video bağlantısını giriniz" />
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="ti ti-device-floppy"></i> Kaydet
                </button>
                <button type="reset" class="btn btn-outline-secondary">
                    <i class="ti ti-refresh"></i> Temizle
                </button>
            </div>
        </form>
    </div>
</div>

