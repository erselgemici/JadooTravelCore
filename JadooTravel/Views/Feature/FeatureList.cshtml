@model List<JadooTravel.Dtos.FeatureDtos.ResultFeatureDto>
@{
    ViewData["Title"] = "Özellikler Listesi";
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <!-- Başlık Alanı -->
        <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between rounded-top">
            <h5 class="mb-0">
                <iconify-icon icon="mdi:video-outline" class="me-2"></iconify-icon> Özellikler
            </h5>
            <a href="/Feature/CreateFeature" class="btn btn-light btn-sm">
                <iconify-icon icon="mdi:plus-circle-outline" class="me-1"></iconify-icon> Yeni Özellik Ekle
            </a>
        </div>

        <!-- Tablo Alanı -->
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Ana Başlık</th>
                            <th>Açıklama</th>
                            <th>Video URL</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.FeatureId</td>
                                <td>@item.Title</td>
                                <td>@item.MainTitle</td>
                                <td class="text-truncate" style="max-width: 250px;">@item.Description</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.VideoUrl))
                                    {
                                        <a href="@item.VideoUrl" target="_blank" class="text-decoration-none text-info">
                                            <iconify-icon icon="mdi:play-circle-outline" class="me-1"></iconify-icon> Video
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Yok</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    <div class="d-flex justify-content-center align-items-center gap-2">
                                        <a href="/Feature/UpdateFeature/@item.FeatureId" class="btn btn-outline-success btn-sm d-flex align-items-center">
                                            <iconify-icon icon="mdi:pencil-outline" class="me-1"></iconify-icon> Güncelle
                                        </a>
                                        <a href="/Feature/DeleteFeature/@item.FeatureId" class="btn btn-outline-danger btn-sm d-flex align-items-center">
                                            <iconify-icon icon="mdi:delete-outline" class="me-1"></iconify-icon> Sil
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
