@model List<string>
@{
    Layout = null;
}

<div class="container mt-5">
    <h4 class="fw-bold mb-4 text-primary text-center">
        🌍 Yapay Zekâ ile Gezi Önerileri
    </h4>

    <div class="row justify-content-center">
        @foreach (var item in Model)
        {
            // Mekan adını düzenle
            var placeName = item.Split(':', '.', '-')[0].Trim();

            <div class="col-md-5 col-lg-4 mb-4">
                <div class="card shadow-sm border-0 h-100" style="border-radius:15px;">
                    <div class="card-body">
                        <h5 class="card-title text-dark fw-semibold mb-3">
                            @item.Split(':').FirstOrDefault()
                        </h5>

                        <p class="card-text text-secondary" style="font-size: 0.9rem;">
                            @(item.Contains(":") ? item.Split(':').LastOrDefault() : "")
                        </p>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-muted">⭐ Popüler Nokta</small>

                            <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(placeName)"
                               target="_blank"
                               class="btn btn-outline-warning btn-sm rounded-pill px-3">
                                Haritada Gör
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
