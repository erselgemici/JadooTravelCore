<!-- 🌍 Google Translate Widget -->
<div id="google_translate_element" style="position: fixed; bottom: 20px; right: 20px; z-index: 9999;"></div>

<script type="text/javascript">
    function googleTranslateElementInit() {
      new google.translate.TranslateElement({
        pageLanguage: 'tr', // orijinal dilin
        includedLanguages: 'tr,en,fr,de,es,it,ru,ar', // desteklenen diller
        layout: google.translate.TranslateElement.InlineLayout.SIMPLE
      }, 'google_translate_element');
    }
</script>

<script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>


<script>
    document.getElementById("aiTravelForm").addEventListener("submit", async function (e) {
        e.preventDefault();

        const city = document.getElementById("cityInput").value;
        const country = document.getElementById("countryInput").value;
        const container = document.getElementById("travelResults");
        const modal = new bootstrap.Modal(document.getElementById('travelAiModal'));

        // 🔄 Modalı açmadan önce yükleniyor animasyonu göster
        container.innerHTML = `
            <div class='text-center my-5'>
                <div class='spinner-border text-warning mb-3'></div>
                <p class='text-secondary'>Yapay zekâ önerileri hazırlanıyor...</p>
            </div>`;

        modal.show();

        try {
            const response = await fetch("/TravelAi/GetPlaces", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `city=${encodeURIComponent(city)}&country=${encodeURIComponent(country)}`
            });

            const html = await response.text();
            container.innerHTML = html;
        } catch (error) {
            container.innerHTML = `<div class='alert alert-danger text-center'>Bir hata oluştu: ${error.message}</div>`;
        }
    });
</script>
<script>
    document.querySelectorAll(".card-img-top").forEach(img => {
        img.onerror = () => {
            img.src = "https://source.unsplash.com/600x400/?travel"; // yedek resim
        };
    });
</script>
