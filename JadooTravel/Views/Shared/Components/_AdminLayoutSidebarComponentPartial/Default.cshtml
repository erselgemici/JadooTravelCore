
@*
    Admin Layout Sidebar
*@
<aside class="left-sidebar">
    <div>
        <!-- Logo -->
        <div class="brand-logo d-flex align-items-center justify-content-between">
            <a href="/Dashboard/Index" class="text-nowrap logo-img d-flex align-items-center">
                <img src="~/Spike-1.0.0/src/assets/images/logos/logo.svg" alt="Logo" />
            </a>
        </div>

        <!-- Sidebar Navigation -->
        <nav class="sidebar-nav scroll-sidebar" data-simplebar="">
            <ul id="sidebarnav" class="mt-3">

                <!-- Bölüm: İçerik Yönetimi -->
                <li class="nav-small-cap mt-3 text-muted fw-semibold fs-2">İçerik Yönetimi</li>

                <li class="sidebar-item">
                    <a class="sidebar-link" href="/Dashboard/Index">
                        <i class="ti ti-dashboard text-primary fs-5"></i>
                        <span class="hide-menu">Dashboard</span>
                    </a>
                </li>

                <li class="sidebar-item">
                    <a class="sidebar-link" href="/Category/CategoryList">
                        <i class="ti ti-category text-success fs-5"></i>
                        <span class="hide-menu">Kategoriler</span>
                    </a>
                </li>

                <li class="sidebar-item">
                    <a class="sidebar-link" href="/Destination/DestinationList">
                        <i class="ti ti-map-pin text-info fs-5"></i>
                        <span class="hide-menu">Turlarımız</span>
                    </a>
                </li>

                <li class="sidebar-item">
                    <a class="sidebar-link" href="/Feature/FeatureList">
                        <i class="ti ti-star text-warning fs-5"></i>
                        <span class="hide-menu">Öne Çıkanlar</span>
                    </a>
                </li>

                <li class="sidebar-item">
                    <a class="sidebar-link" href="/Service/ServiceList">
                        <i class="ti ti-briefcase text-secondary fs-5"></i>
                        <span class="hide-menu">Hizmetlerimiz</span>
                    </a>
                </li>             

                <li class="sidebar-item">
                    <a class="sidebar-link" href="/Booking/Index">
                        <i class="ti ti-calendar-event text-danger fs-5"></i>
                        <span class="hide-menu">Rezervasyonlar</span>
                    </a>
                </li>              

                <li class="sidebar-item">
                    <a class="sidebar-link" href="/AdminLogin/Index">
                        <i class="ti ti-user text-dark fs-5"></i>
                        <span class="hide-menu">Adminler</span>
                    </a>
                </li>
            </ul>

            <!-- Çıkış Yap Kartı -->
            <div class="p-3 mt-4 text-center">
                <div class="card bg-light border-0 shadow-none p-3">
                   @*  <img src="~/Spike-1.0.0/src/assets/images/products/s10.jpg" class="img-fluid rounded-3" alt="Logout" /> *@
                    <div class="mt-3">
                        <h6>Çıkış Yap</h6>
                        <a href="/AdminLogin/Logout" class="btn btn-outline-danger w-100">Çık</a>
                    </div>
                </div>
            </div>
        </nav>
    </div>
</aside>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const currentPath = window.location.pathname.toLowerCase();
        document.querySelectorAll("#sidebarnav .sidebar-link").forEach(link => {
            if (link.getAttribute("href").toLowerCase() === currentPath) {
                link.classList.add("active");
                link.closest(".sidebar-item").classList.add("selected");
            }
        });
    });
</script>
