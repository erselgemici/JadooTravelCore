@model JadooTravel.Dtos.BookingDtos.CreateBookingDto

<section class="py-7 bg-light" id="booking">
    <div class="container">
        <div class="row align-items-center">
            <!-- Sol taraf -->
            <div class="col-lg-6">
                <div class="mb-4 text-start">
                    <h5 class="text-secondary">Kolay ve Hızlı Rezervasyon</h5>
                    <h3 class="fs-xl-10 fs-lg-8 fs-7 fw-bold font-cursive text-capitalize">
                        3 Adımda Rezervasyonunuzu Tamamlayın
                    </h3>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <div class="bg-warning me-3 p-3 rounded-circle">
                        <img src="/jadoo/public/assets/img/steps/selection.svg" width="22" alt="steps" />
                    </div>
                    <div>
                        <h5 class="text-secondary fw-bold fs-0">Rota Seçimi</h5>
                        <p>Hayalini kurduğunuz yere doğru ilk adımı atın.</p>
                    </div>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <div class="bg-danger me-3 p-3 rounded-circle">
                        <img src="/jadoo/public/assets/img/steps/water-sport.svg" width="22" alt="steps" />
                    </div>
                    <div>
                        <h5 class="text-secondary fw-bold fs-0">Bilgilerinizi Girin</h5>
                        <p>İletişim bilgilerinizi doldurun, rezervasyonunuzu hemen başlatalım.</p>
                    </div>
                </div>

                <div class="d-flex align-items-start">
                    <div class="bg-info me-3 p-3 rounded-circle">
                        <img src="/jadoo/public/assets/img/steps/taxi.svg" width="22" alt="steps" />
                    </div>
                    <div>
                        <h5 class="text-secondary fw-bold fs-0">Seyahate Hazırlanın</h5>
                        <p>Rezervasyon onayınızla birlikte tatiliniz başlıyor. Hazırlıklarınızı yapın ve keyfini çıkarın!</p>
                    </div>
                </div>
            </div>
            <!-- Sağ taraf -->
            <div class="col-lg-6">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-4">
                        <h4 class="text-center mb-4 fw-bold text-secondary">Rezervasyon Formu</h4>

                        <form method="post" asp-action="CreateBooking" asp-controller="Booking" class="row g-3">
                            <div class="col-12">
                                <input asp-for="NameSurname" class="form-control rounded-pill" placeholder="Ad Soyad" required />
                            </div>
                            <div class="col-12">
                                <input asp-for="Email" type="email" class="form-control rounded-pill" placeholder="E-posta" required />
                            </div>
                            <div class="col-12">
                                <input asp-for="Phone" class="form-control rounded-pill" placeholder="Telefon" required />
                            </div>
                            <div class="col-12">
                                <input asp-for="DestinationName" class="form-control rounded-pill" placeholder="Gitmek istediğiniz şehir" required />
                            </div>
                            <div class="col-12">
                                <input asp-for="PersonCount" type="number" class="form-control rounded-pill" placeholder="Kişi Sayısı" required />
                            </div>
                            <div class="col-12">
                                <input asp-for="BookingDate" type="date" class="form-control rounded-pill" required />
                            </div>
                            <div class="col-12">
                                <textarea asp-for="Note" class="form-control rounded-4" rows="3" placeholder="Eklemek istediğiniz notlar..."></textarea>
                            </div>
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-warning text-white px-5 py-2 rounded-pill">
                                    Rezervasyon Yap
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (TempData["BookingMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'success',
                title: 'Rezervasyon Başarılı 🎉',
                text: '@Html.Raw(TempData["BookingMessage"])',
                confirmButtonColor: '#3085d6'
            });
        });
    </script>
}


