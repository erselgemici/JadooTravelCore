@model JadooTravel.Dtos.ReservationDtos.UpdateReservationDto
@{
    ViewData["Title"] = "Rezervasyon Güncelle";
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between rounded-top">
            <h5 class="mb-0">
                <iconify-icon icon="mdi:account-edit-outline" class="me-2"></iconify-icon> Rezervasyon Güncelle
            </h5>
            <a href="/Reservation/Index" class="btn btn-light btn-sm">
                <iconify-icon icon="mdi:arrow-left"></iconify-icon> Geri Dön
            </a>
        </div>

        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" asp-for="ReservationId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Ad Soyad</label>
                        <input asp-for="NameSurname" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Telefon</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">E-Posta</label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Tur (Destination ID)</label>
                        <input asp-for="DestinationId" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-success d-flex align-items-center">
                        <iconify-icon icon="mdi:content-save-outline" class="me-1"></iconify-icon> Güncelle
                    </button>
                    <a href="/Reservation/Index" class="btn btn-outline-secondary d-flex align-items-center">
                        <iconify-icon icon="mdi:cancel"></iconify-icon> İptal
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
