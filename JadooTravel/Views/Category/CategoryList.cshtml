@model List<JadooTravel.Dtos.CategoryDtos.ResultCategoryDto>
@{
    ViewData["Title"] = "Kategori Listesi";
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between">
            <h5 class="mb-0">
                <iconify-icon icon="mdi:view-list-outline" class="me-2"></iconify-icon> Kategori Listesi
            </h5>
            <a href="/Category/CreateCategory" class="btn btn-light btn-sm">
                <iconify-icon icon="mdi:plus-circle-outline" class="me-1"></iconify-icon> Yeni Ekle
            </a>
        </div>

        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table align-middle table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Kategori Adı</th>
                            <th>Açıklama</th>
                            <th>İkon</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CategoryId</td>
                                <td>@item.CategoryName</td>
                                <td>@item.Description</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.IconUrl))
                                    {
                                        <img src="@item.IconUrl" alt="icon" width="35" class="rounded" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">Yok</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Category/UpdateCategory/@item.CategoryId" class="btn btn-outline-success btn-sm">
                                        <iconify-icon icon="mdi:pencil-outline"></iconify-icon> Güncelle
                                    </a>
                                    <a href="/Category/DeleteCategory/@item.CategoryId" class="btn btn-outline-danger btn-sm ms-1">
                                        <iconify-icon icon="mdi:delete-outline"></iconify-icon> Sil
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
